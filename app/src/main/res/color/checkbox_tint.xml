<?xml version="1.0" encoding="utf-8"?>
<!-- design.md §3.1: the row checkbox is green when checked, the outline color otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/mx_green" android:state_checked="true" />
    <item android:color="?attr/colorOutline" />
</selector>
