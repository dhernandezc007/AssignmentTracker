<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device transfer for API 31+ (SEC-0-2). Keep identical to backup_rules.xml.
    Only the Room database is included; future auth/session prefs are excluded.
-->
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools">
    <cloud-backup>
        <include domain="database" path="assignments.db" />
        <!-- Forward guard: a no-op today (no prefs are included), but it still wins if anyone
             later adds a sharedpref include. Lint flags that as "not in an included path". -->
        <exclude domain="sharedpref" path="auth_session.xml" tools:ignore="FullBackupContent" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="assignments.db" />
        <!-- Forward guard: a no-op today (no prefs are included), but it still wins if anyone
             later adds a sharedpref include. Lint flags that as "not in an included path". -->
        <exclude domain="sharedpref" path="auth_session.xml" tools:ignore="FullBackupContent" />
    </device-transfer>
</data-extraction-rules>
