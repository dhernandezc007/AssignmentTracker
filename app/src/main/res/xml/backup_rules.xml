<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup for API 30 and below (SEC-0-2). Keep identical to data_extraction_rules.xml.
    Only the Room database is backed up (AppDatabase.DB_NAME; TRUNCATE journal, so it is a
    single file). Any future auth/session prefs are excluded so a session token is never
    restored onto another device.
-->
<full-backup-content xmlns:tools="http://schemas.android.com/tools">
    <include domain="database" path="assignments.db" />
    <!-- Forward guard: a no-op today (no prefs are included), but it still wins if anyone
         later adds a sharedpref include. Lint flags that as "not in an included path". -->
    <exclude domain="sharedpref" path="auth_session.xml" tools:ignore="FullBackupContent" />
</full-backup-content>
