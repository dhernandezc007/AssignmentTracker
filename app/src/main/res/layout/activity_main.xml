<?xml version="1.0" encoding="utf-8"?>
<!-- Home, design.md §2 (Slice 1 subset: header band, title, flat list, empty state, FAB). -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header: not scrolling. Status-bar inset is applied as top padding in code. -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/banner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/banner_height"
                android:importantForAccessibility="no"
                android:scaleType="matrix"
                android:src="@drawable/papel_picado_wide" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:gravity="center_vertical|start"
                android:minHeight="@dimen/title_row_height"
                android:paddingStart="@dimen/space_screen"
                android:paddingEnd="@dimen/space_screen"
                android:text="@string/home_title"
                android:textAppearance="@style/TextAppearance.AT.ScreenTitle"
                tools:targetApi="28" />
        </LinearLayout>

        <!-- Bottom padding (96dp + nav-bar inset) is set in code so the last row clears the FAB. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/list_bottom_clearance"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:targetApi="26" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAdd"
        style="@style/Widget.AT.ExtendedFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_screen"
        android:contentDescription="@string/fab_add"
        android:text="@string/fab_add"
        app:icon="@drawable/ic_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
