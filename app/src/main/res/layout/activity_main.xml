<?xml version="1.0" encoding="utf-8"?>
<!-- Home, design.md §2 (Slice 1 subset: header band, title, flat list, empty state, FAB). -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header: not scrolling. Status-bar inset is applied as top padding in code. -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/banner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/banner_height"
                android:importantForAccessibility="no"
                android:scaleType="matrix"
                android:src="@drawable/papel_picado_wide" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:gravity="center_vertical|start"
                android:minHeight="@dimen/title_row_height"
                android:paddingStart="@dimen/space_screen"
                android:paddingEnd="@dimen/space_screen"
                android:text="@string/home_title"
                android:textAppearance="@style/TextAppearance.AT.ScreenTitle"
                tools:targetApi="28" />
        </LinearLayout>

        <!-- Bottom padding (96dp + nav-bar inset) is set in code so the last row clears the FAB. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/list_bottom_clearance"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:targetApi="26" />

        <!-- Study buddy: abuelita / abuelo cheering you on. Nav-bar inset is applied as
             bottom padding in code; the FAB sits above this strip. -->
        <LinearLayout
            android:id="@+id/buddy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_buddy_strip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_screen"
            android:paddingTop="@dimen/buddy_padding_v"
            android:paddingEnd="@dimen/space_screen"
            android:paddingBottom="@dimen/buddy_padding_v">

            <ImageView
                android:id="@+id/buddyAvatar"
                android:layout_width="@dimen/buddy_avatar"
                android:layout_height="@dimen/buddy_avatar"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/buddy_cd_abuelita"
                android:src="@drawable/buddy_abuelita" />

            <TextView
                android:id="@+id/buddyBubble"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/buddy_bubble_gap"
                android:layout_weight="1"
                android:background="@drawable/bg_buddy_bubble"
                android:foreground="?attr/selectableItemBackground"
                android:minHeight="@dimen/touch_target"
                android:gravity="center_vertical|start"
                android:paddingStart="@dimen/buddy_bubble_padding_h"
                android:paddingTop="@dimen/buddy_bubble_padding_v"
                android:paddingEnd="@dimen/buddy_bubble_padding_h"
                android:paddingBottom="@dimen/buddy_bubble_padding_v"
                android:textAppearance="@style/TextAppearance.AT.BuddyBubble" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom margin is set in code so the FAB sits just above the study buddy strip. -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAdd"
        style="@style/Widget.AT.ExtendedFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_screen"
        android:contentDescription="@string/fab_add"
        android:text="@string/fab_add"
        app:icon="@drawable/ic_add" />

    <!-- Mark-done fiesta: papel picado confetti over everything. Draw-only, never touchable. -->
    <com.example.assignmenttracker.ui.fiesta.ConfettiView
        android:id="@+id/confetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="@dimen/confetti_elevation"
        android:importantForAccessibility="no" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
