<?xml version="1.0" encoding="utf-8"?>
<!-- Top of the milpa: why it's here, seeds to plant, progress toward the next one, and stats. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="@dimen/farm_plot_gap">

    <TextView
        android:id="@+id/intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/farm_intro"
        android:textAppearance="@style/TextAppearance.AT.StateBody" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_screen"
        android:background="@drawable/bg_row_single"
        android:orientation="vertical"
        android:padding="@dimen/space_screen">

        <TextView
            android:id="@+id/seeds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.AT.StateTitle"
            tools:targetApi="28"
            tools:text="1 seed to plant" />

        <LinearLayout
            android:id="@+id/progressRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot1"
                android:layout_width="@dimen/farm_progress_dot"
                android:layout_height="@dimen/farm_progress_dot"
                android:background="@drawable/bg_seed_dot_empty" />

            <View
                android:id="@+id/dot2"
                android:layout_width="@dimen/farm_progress_dot"
                android:layout_height="@dimen/farm_progress_dot"
                android:layout_marginStart="@dimen/farm_progress_dot_gap"
                android:background="@drawable/bg_seed_dot_empty" />

            <View
                android:id="@+id/dot3"
                android:layout_width="@dimen/farm_progress_dot"
                android:layout_height="@dimen/farm_progress_dot"
                android:layout_marginStart="@dimen/farm_progress_dot_gap"
                android:background="@drawable/bg_seed_dot_empty" />

            <TextView
                android:id="@+id/progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.AT.RowMeta"
                tools:text="2 of 3 assignments toward your next seed" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlant"
            style="@style/Widget.AT.Button.Pill"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_screen"
            android:text="@string/farm_plant"
            app:icon="@drawable/ic_seedling"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorOnPrimary" />
    </LinearLayout>

    <TextView
        android:id="@+id/stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_screen"
        android:textAppearance="@style/TextAppearance.AT.SectionLabel"
        tools:text="Planted: 4 · Fully grown: 1" />

    <TextView
        android:id="@+id/emptyField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_screen"
        android:text="@string/farm_empty_field"
        android:textAppearance="@style/TextAppearance.AT.RowMeta" />
</LinearLayout>
