<?xml version="1.0" encoding="utf-8"?>
<!-- Slice 1 "title only" dialog, design.md §5.3: same field style as the Slice 2 edit screen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dialog_content_padding"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/dialog_content_padding">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilTitle"
        style="@style/Widget.AT.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/field_title"
        app:counterEnabled="true"
        app:counterMaxLength="200">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLength="200"
            android:maxLines="3" />
    </com.google.android.material.textfield.TextInputLayout>
</FrameLayout>
