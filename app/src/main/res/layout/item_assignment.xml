<?xml version="1.0" encoding="utf-8"?>
<!--
    Row, design.md §3.1. The card root (bg_row_*, clipToOutline) is not focusable. Inside it the
    48dp checkbox (mark done) and the row body (open Add/Edit) are siblings, checkbox first, so
    TalkBack reaches the checkbox before the body (QA-3-1, DES-3-4, §10). The two targets never
    overlap. The body is one focusable node whose content description the adapter sets (title,
    course, spoken due label); its ripple and focus state are its foreground, clipped to the card
    corners by the root. The background, the rule, the min height and line 2 are set by the adapter.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_screen"
    android:layout_marginEnd="@dimen/space_screen"
    android:background="@drawable/bg_row_single"
    android:clipToOutline="true"
    android:orientation="vertical"
    tools:targetApi="31">

    <LinearLayout
        android:id="@+id/rowContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 48dp target, 4dp in: the 18dp box sits about 19dp from the card edge (§3.1).
             Content description ("Done: <title>") is set per row by the adapter. -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/rowCheck"
            android:layout_width="@dimen/checkbox_target"
            android:layout_height="@dimen/checkbox_target"
            android:layout_marginStart="@dimen/checkbox_margin_start"
            android:minWidth="@dimen/checkbox_target"
            android:minHeight="@dimen/checkbox_target"
            app:buttonTint="@color/checkbox_tint" />

        <LinearLayout
            android:id="@+id/rowBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="@dimen/row_min_one_line"
            android:orientation="vertical"
            android:paddingStart="0dp"
            android:paddingTop="@dimen/space_row_v"
            android:paddingEnd="@dimen/space_screen"
            android:paddingBottom="@dimen/space_row_v">

            <TextView
                android:id="@+id/rowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:breakStrategy="balanced"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.AT.RowTitle"
                tools:text="Lab report: enzyme activity" />

            <TextView
                android:id="@+id/rowMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.AT.RowMeta"
                android:visibility="gone"
                tools:text="Overdue · Thu, Nov 6 · Biology 101"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/rowRule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/text_start_in_card"
        android:layout_marginEnd="@dimen/space_screen"
        android:background="?attr/colorOutlineVariant"
        android:importantForAccessibility="no" />
</LinearLayout>
