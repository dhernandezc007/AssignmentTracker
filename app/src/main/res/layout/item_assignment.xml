<?xml version="1.0" encoding="utf-8"?>
<!--
    Row, design.md §3.1, Slice 2 subset: title plus line 2 (course, hidden when empty). No
    checkbox yet (Slice 3) and no due label (Slice 4). The whole row is one tappable,
    focusable node that opens Add/Edit. The ripple and focus state (DES-1-4) are the
    foreground, clipped to the bg_row_* shape by clipToOutline. The background (bg_row_*),
    the rule and the min height are set by the adapter.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_screen"
    android:layout_marginEnd="@dimen/space_screen"
    android:background="@drawable/bg_row_single"
    android:clickable="true"
    android:clipToOutline="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    tools:targetApi="31">

    <LinearLayout
        android:id="@+id/rowBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/row_min_one_line"
        android:orientation="vertical"
        android:paddingStart="@dimen/row_text_start"
        android:paddingTop="@dimen/space_row_v"
        android:paddingEnd="@dimen/space_screen"
        android:paddingBottom="@dimen/space_row_v">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.AT.RowTitle"
            tools:text="Lab report: enzyme activity" />

        <TextView
            android:id="@+id/rowMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.AT.RowMeta"
            android:visibility="gone"
            tools:text="Biology 101"
            tools:visibility="visible" />
    </LinearLayout>

    <View
        android:id="@+id/rowRule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/row_text_start"
        android:layout_marginEnd="@dimen/space_screen"
        android:background="?attr/colorOutlineVariant"
        android:importantForAccessibility="no" />
</LinearLayout>
