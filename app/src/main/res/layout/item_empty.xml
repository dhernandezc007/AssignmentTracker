<?xml version="1.0" encoding="utf-8"?>
<!-- Empty state, design.md §3.5: top-weighted, centered horizontally, the FAB is the action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_screen"
    android:paddingTop="@dimen/empty_top"
    android:paddingEnd="@dimen/space_screen"
    android:paddingBottom="@dimen/space_screen">

    <ImageView
        android:id="@+id/emptyArt"
        android:layout_width="@dimen/empty_art_width"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:src="@drawable/art_flags" />

    <TextView
        android:id="@+id/emptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/empty_title"
        android:textAppearance="@style/TextAppearance.AT.StateTitle" />

    <TextView
        android:id="@+id/emptyBody"
        android:breakStrategy="balanced"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:maxWidth="@dimen/empty_body_max_width"
        android:text="@string/empty_body"
        android:textAppearance="@style/TextAppearance.AT.StateBody" />
</LinearLayout>
